# MongoDB Atlas
# Não envie o arquivo .env real para o GitHub.
MONGODB_URI=mongodb+srv://USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/KorczakTechSite?retryWrites=true&w=majority

# Segurança
JWT_SECRET=gere_um_segredo_longo_e_aleatorio

# E-mail / SMTP
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=KZTechnologies@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_ou_credencial_smtp
