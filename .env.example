# MongoDB Atlas
# Crie o usuário do banco como Korczak e gere uma senha forte no Atlas.
# Não envie o arquivo .env real para o GitHub.
MONGODB_URI=mongodb+srv://Korczak:SUA_SENHA@SEU_CLUSTER.mongodb.net/KorczakTechSite?retryWrites=true&w=majority

# Segurança
JWT_SECRET=gere_um_segredo_longo_e_aleatorio
ADMIN_SETUP_TOKEN=gere_um_token_privado_para_o_primeiro_admin

# Opcional: restringir origens CORS separadas por vírgula
CORS_ORIGIN=
