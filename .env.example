# Mercado Pago
# Configure estes valores somente como variáveis de ambiente no Render.
# sandbox: use credenciais de teste e valide o fluxo completo sem operar pagamentos reais.
# production: use credenciais reais somente após a validação.
MERCADO_PAGO_MODE=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
PUBLIC_API_URL=https://kzsite.onrender.com

# Desenvolvimento local
